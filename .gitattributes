# Store text files with LF line endings in the repo and check them out as LF
* text=auto eol=lf

# Windows scripts keep CRLF (PowerShell/cmd convention)
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never convert line endings or diff them as text
*.wav     binary
*.flac    binary
*.mp3     binary
*.png     binary
*.jpg     binary
*.parquet binary
